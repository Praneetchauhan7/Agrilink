# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATA_GOV_API_KEY: Official API Key for data.gov.in (Government of India Open Government Data Platform).
# Used to fetch live APMC mandi prices from the official dataset:
# https://www.data.gov.in/catalog/current-daily-price-various-commodities-various-markets-mandi
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
# To obtain a free API key, register at https://data.gov.in -> My Account -> API Key.
DATA_GOV_API_KEY=""

# JWT_SECRET: Secret key for signing authentication JSON Web Tokens
JWT_SECRET=""

# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
